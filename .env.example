# Gravitee Quiz Events - local development settings
#
#   cp .env.example .env        (optional: every value below already has this default)
#   docker compose up -d --build   ->   http://localhost:8080
#
# docker compose reads .env automatically. These values are for LOCAL DEV ONLY.
# Production does not use this file: its configuration lives in Kubernetes
# (k8s/configmaps.yaml and the secrets quiz-backend-secret / quiz-db-secret).
# See docs/DEPLOYMENT.md.

# ---------------------------------------------------------------------------
# Entry point (everything is served from ONE origin by the gateway container)
#   http://localhost:8080/            hub
#   http://localhost:8080/{slug}      event game (e.g. /api-masters)
#   http://localhost:8080/{slug}/scoreboard
#   http://localhost:8080/admin/      admin console
#   http://localhost:8080/api/...     backend API
# ---------------------------------------------------------------------------
GATEWAY_PORT=8080
# Direct access to the backend and the database, bound to 127.0.0.1 only.
BACKEND_PORT=8000
DB_PORT=5432

# ---------------------------------------------------------------------------
# Frontends (web + admin-console)
# ---------------------------------------------------------------------------
# Where the browser finds the API; written to /config.js when the container starts.
# Keep "/api" (same origin: no CORS, nothing to configure). An absolute URL such as
# https://quiz-api.example.com/api also works: the Content-Security-Policy connect-src is
# extended to that origin and the backend must list the page origin in CORS_ORIGINS.
API_BASE_URL=/api

# ---------------------------------------------------------------------------
# Backend
# ---------------------------------------------------------------------------
# dev | test | production. "production" refuses to start with the default SECRET_KEY or
# ADMIN_PASSWORD=admin, so do not set it locally unless you also change those two.
APP_ENV=dev
# JWT signing key. Any value of 32+ characters (generate: openssl rand -base64 48).
SECRET_KEY=dev-only-secret-key-do-not-use-in-production-0123456789
# Admin console / admin API login.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin
# Same-origin through the gateway needs no CORS. Only needed for tools calling the API
# from another origin (comma separated). Defaults to the gateway origin.
# CORS_ORIGINS=http://localhost:8080,http://127.0.0.1:8080
# Seed events/api-masters.json when the database has no event yet (fresh volume).
SEED_ON_STARTUP=true
# A game can only be submitted with the token returned at start (anti tampering). Keep true.
REQUIRE_SUBMIT_TOKEN=true
# Admin login throttle: 10 failures slow an IP down, this many lock it for 5 minutes.
LOGIN_HARD_MAX_FAILURES=50
LOG_LEVEL=INFO

# ---------------------------------------------------------------------------
# Database (compose creates it; backend connects with the same values)
# ---------------------------------------------------------------------------
POSTGRES_DB=gravitee_quiz
POSTGRES_USER=quiz_user
POSTGRES_PASSWORD=quiz_password

# ---------------------------------------------------------------------------
# scripts/quizctl.py (read from the shell, not by compose)
#   export QUIZ_API_URL=http://localhost:8080/api
#   export QUIZ_ADMIN_USER=admin
#   export QUIZ_ADMIN_PASSWORD=admin        # admin/admin is only assumed for localhost
# ---------------------------------------------------------------------------
